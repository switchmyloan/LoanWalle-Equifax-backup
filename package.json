    "serve": "node src/server.js"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "engines": {
    "node": ">=18"
  }
}
