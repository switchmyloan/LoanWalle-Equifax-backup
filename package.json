{
  "name": "loanwalle-status-cron",
  "version": "1.0.0",
  "description": "Polls the LoanWalle affiliate user-status API for each lead and persists every response to ClickHouse",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
